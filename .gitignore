# Only the release is tracked. Anything else in a working copy stays local.
/*
!/.gitattributes
!/.gitignore
!/LICENSE
!/README.md
!/requirements.txt
!/agents/
!/analysis/
!/configs/
!/data/
!/paper/
!/scripts/
!/benchmark/
!/submissions/
/submissions/*
!/submissions/README.md
!/wingbench/

# Python, editors, OS, secrets
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
*.swp
*~
.env
.env.*
*.pem
*.key
credentials.json
*.log
*.zip

# analysis keeps its scripts and the outputs as published. The figures it
# draws for inspection are rebuilt by run_all.sh; the paper draws its own.
/analysis/figures/
/analysis/out/agent_campaign/
/analysis/out/macros/.main_tex_rendered.sha256
/analysis/06_exposure.py
/analysis/07_audit.py
/analysis/08_render_markdown.py
/analysis/09_render_pdf.py
/analysis/10_render_latex.py
/analysis/14_condition_timing.py
/analysis/15_export_designs.py
/analysis/17_export_candidates.py
/analysis/18_ablate_weight.py
/analysis/19_export_weight_ablation.py
/analysis/20_agent_campaign.py
/analysis/smac3/smac3_timing_extract.py
/analysis/out/audit.json
/analysis/out/exposure.json
/analysis/out/macros/crash_macros.json
/analysis/out/grades.csv
/analysis/out/episodes.csv
/analysis/out/curves.csv
/analysis/out/discovery.csv
/analysis/out/replay_meta.csv
/analysis/out/verification.json
/analysis/out/load_meta.json
/analysis/smac3/smac3_ck32_assemble.py
/analysis/smac3/smac3_recommendation_curve.py
/analysis/INTERPRETATION_RATIFICATION.md
/analysis/test_agent_endpoints.py

# paper keeps its source, the files it includes, and the generated number files
