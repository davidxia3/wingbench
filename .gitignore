!/paper/app_fig_yield_by_cell.pdf
!/paper/app_fig_online_yield_vs_index.pdf
!/paper/app_fig_discovery_vs_recommendation.pdf
!/paper/app_fig_fresh_hidden_vs_online_yield.pdf

